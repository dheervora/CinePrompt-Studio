# Required for the AI features (Supercharger, Practice grading, A/B image comparison).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Text model and its fallback (both on Gemini's free tier).
TEXT_MODEL="gemini-3.8-flash"
FALLBACK_TEXT_MODEL="gemini-3.7-flash"

# Image generation has no free tier: it only works once billing is enabled on your AI Studio project.
# Without billing, the app offers a free route (make images in the Gemini app and upload them).
IMAGE_MODEL="gemini-3.1-flash-lite-image"
# Set to "off" to hide in-app image generation entirely.
# IMAGE_GENERATION="off"

# The server only listens on this computer by default. Use 0.0.0.0 to expose it on your network.
# HOST="127.0.0.1"
# PORT="3000"
